{
  "name": "ai-speech-rx",
  "version": "0.1.0",
  "private": true,
  "description": "Local doctor–patient conversation → ophthalmology terminology → prescription draft (ASR + Ollama/LM Studio)",
  "type": "module",
  "engines": { "node": ">=20.12" },
  "scripts": {
    "build-kb": "tsx src/cli.ts build-kb",
    "transcribe": "tsx src/cli.ts transcribe",
    "extract": "tsx src/cli.ts extract",
    "run": "tsx src/cli.ts run",
    "match": "tsx src/cli.ts match",
    "check": "tsx src/cli.ts check",
    "serve": "tsx src/server.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
