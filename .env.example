# ---------- Speech-to-text ----------
# whisper-cli (English + Hindi + Bengali) | indic (Indian-trained models for Hindi/Bengali, Whisper for English)
# | whisper-server | openai | qwen3-mlx (English/Hindi only)
ASR_BACKEND=whisper-cli
# ASR_BACKEND=indic — model per language (Hugging Face ids; downloaded on first use)
#   Hindi:   ARTPARK-IISc/whisper-large-v3-vaani-hindi (default) or ai4bharat/indic-conformer-600m-multilingual
#   Bengali: ARTPARK-IISc/whisper-medium-vaani-bengali (default) or ai4bharat/indic-conformer-600m-multilingual
INDIC_MODEL_HI=ARTPARK-IISc/whisper-large-v3-vaani-hindi
INDIC_MODEL_BN=ai4bharat/indic-conformer-600m-multilingual
# IndicConformer only: rnnt (more accurate) | ctc (faster)
INDIC_DECODING=rnnt
# "" = auto-detect per recording, or force: en | hi | bn   (the web UI has a per-visit dropdown)
ASR_LANGUAGE=
# auto = for Hindi/Bengali audio, also make an English translation (2nd Whisper pass) | off
ASR_TRANSLATE=auto
PYTHON=python3
QWEN3_ASR_MODEL=Qwen/Qwen3-ASR-1.7B
# whisper.cpp
WHISPER_CLI=whisper-cli
WHISPER_MODEL=models/ggml-large-v3.bin
WHISPER_SERVER_URL=http://127.0.0.1:8080
# any OpenAI-compatible /v1/audio/transcriptions server
ASR_OPENAI_BASE_URL=http://127.0.0.1:8000/v1
ASR_OPENAI_MODEL=whisper-large-v3

# ---------- Extraction LLM ----------
# ollama | lmstudio | openai
LLM_PROVIDER=ollama
# leave empty for defaults: ollama http://127.0.0.1:11434 · lmstudio http://127.0.0.1:1234/v1
LLM_BASE_URL=
# ollama: a tag from `ollama list` (e.g. qwen3:8b)
# lmstudio: auto = whatever model is loaded in LM Studio, or an exact id from `curl http://127.0.0.1:1234/v1/models`
LLM_MODEL=qwen3:8b
# 12288 fits comfortably on a 16 GB M4 with qwen3:8b; raise to 16384 on 24/32 GB
LLM_NUM_CTX=12288
# false = skip the reasoning phase on thinking models (faster, cleaner JSON)
LLM_THINK=false
MAX_CANDIDATES=60
SCENARIO_EXAMPLES=1

PORT=5055

   LLM_MODEL=qwen/qwen3-4b-2507

# ---------- Stage 1: transcription accuracy ----------
# tier thresholds (0..1): high / medium / low; below low = unusable
QUALITY_HIGH=0.75
QUALITY_MEDIUM=0.55
QUALITY_LOW=0.35
# on = don't run the LLM on an "unusable" transcript (terms still listed; --force or "Generate anyway" overrides) | off
QUALITY_GATE=on
# ASR token probability below which a word counts as low-confidence (flags medical terms heard there)
ASR_LOW_CONF=0.5
